# =============================================================
# Laravel — Railway Environment Variable Template
#
# How to use:
#   1. In Railway dashboard → each service → Variables tab
#   2. Add each variable below with its real value
#   3. Variables using ${{ }} are Railway reference variables —
#      Railway resolves them automatically. Copy the syntax as-is.
#   4. Never commit real secrets to this file.
# =============================================================

# ─── Application ─────────────────────────────────────────────
APP_NAME="AccuLab"
APP_ENV=production
# Generate locally: php artisan key:generate --show
APP_KEY=base64:REPLACE_WITH_GENERATED_KEY
APP_DEBUG=false
APP_TIMEZONE=Africa/Cairo
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# app service: reference own injected domain
# APP_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}
#
# worker + cron services: reference app service by its Railway service name
# APP_URL=https://${{app.RAILWAY_PUBLIC_DOMAIN}}

# ─── Maintenance ─────────────────────────────────────────────
APP_MAINTENANCE_DRIVER=file

# ─── Logging ─────────────────────────────────────────────────
# stderr routes all PHP output to Railway's real-time log stream.
LOG_CHANNEL=stderr
LOG_STACK=single
LOG_LEVEL=error
LOG_DEPRECATIONS_CHANNEL=null

# ─── Database ────────────────────────────────────────────────
# Reference Railway MySQL plugin variables by the service name you
# gave the MySQL service in your Railway project (e.g. "MySQL").
DB_CONNECTION=mysql
DB_HOST=${{MySQL.MYSQLHOST}}
DB_PORT=${{MySQL.MYSQLPORT}}
DB_DATABASE=${{MySQL.MYSQLDATABASE}}
DB_USERNAME=${{MySQL.MYSQLUSER}}
DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}

# ─── Cache ───────────────────────────────────────────────────
CACHE_STORE=database
CACHE_DATABASE_TABLE=cache
CACHE_DATABASE_LOCK_TABLE=cache_locks
CACHE_PREFIX=acculab_

# ─── Session ─────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# ─── Queue ───────────────────────────────────────────────────
QUEUE_CONNECTION=database
QUEUE_FAILED_DRIVER=database-uuids

# ─── Filesystem ──────────────────────────────────────────────
# Volume must be mounted at /app/storage/app/public on the app service.
FILESYSTEM_DISK=public

# ─── Broadcasting ────────────────────────────────────────────
BROADCAST_CONNECTION=log

# ─── Hashing ─────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ─── Mail ────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@acculab.org"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Migration pipeline ──────────────────────────────────────
MIGRATION_LOG_LEVEL=info

# ─── Vite / assets ───────────────────────────────────────────
# app service only — used by Vite manifest resolution in Blade templates.
# VITE_APP_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}

# ─── Railway internals (do not set manually) ─────────────────
# PORT              — injected by Railway into the app service automatically
# RAILWAY_PUBLIC_DOMAIN — injected by Railway when a public domain is assigned
